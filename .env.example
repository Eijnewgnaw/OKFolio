LLM_API_BASE=http://model-server/compatible-mode/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_RESPONSE_FORMAT=json_object
SOURCES_DIR=/app/runtime/data/normalized-sources

# cli, mineru-http-client (recommended), or openai-compatible (generic fallback)
MINERU_PROVIDER=mineru-http-client
MINERU_API_BASE=http://model-server/compatible-mode/v1
MINERU_API_KEY=replace-me
MINERU_MODEL=replace-me
MINERU_TIMEOUT=180
MINERU_MAX_CONCURRENCY=8

# off or vlm. Only visual-only pages are sent to this constrained classifier.
PAGE_ROLE_CLASSIFIER=vlm
PAGE_ROLE_API_BASE=http://model-server/compatible-mode/v1
PAGE_ROLE_API_KEY=replace-me
PAGE_ROLE_MODEL=replace-me
PAGE_ROLE_TIMEOUT=120
PAGE_RECOVERY_API_BASE=
PAGE_RECOVERY_API_KEY=
PAGE_RECOVERY_MODEL=
PAGE_RECOVERY_TIMEOUT=180
PAGE_RECOVERY_MAX_TOKENS=4096

# local, minio, or s3writer
DATA_ASSET_MODE=local
S3_ENDPOINT=http://minio-server:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=okfolio-assets
S3_PREFIX=okfolio
S3_REGION=us-east-1
S3_VERIFY_TLS=false
S3_PUBLIC_BASE_URL=

MCP_ENABLE_WRITES=false
OKFOLIO_MCP_PORT=3099
