# OpenAI or any OpenAI-compatible Chat Completions service.
# Leave OPENAI_BASE_URL empty to use the provider's standard endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSE_FORMAT=json_object
OPENAI_TIMEOUT_SECONDS=900
OPENAI_MAX_ATTEMPTS=2
OPENAI_ENABLE_THINKING=false
OPENAI_MAX_TOKENS=32768
SOURCES_DIR=/app/runtime/data/normalized-sources

# Optional three-arm RAG evaluation backend. Keep local model directories and
# endpoint details in the environment, not in committed experiment configs.
RAG_BGE_M3_MODEL_PATH=
RAG_BGE_M3_REVISION=
RAG_BGE_RERANKER_MODEL_PATH=
RAG_BGE_RERANKER_REVISION=
RAG_BGE_DEVICE=cpu
RAG_BGE_DENSE_BATCH_SIZE=4
RAG_BGE_DENSE_CACHE_BLOCK_SIZE=64
RAG_BGE_RERANKER_BATCH_SIZE=2
RAG_JIEBA_DICTIONARY_PATH=
RAG_TOKENIZER_MODEL_PATH=
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
RAG_LLM_TIMEOUT_SECONDS=180
RAG_LLM_MAX_OUTPUT_TOKENS=1024
RAG_LLM_TEMPERATURE=0

# cli, openai-compatible, or mineru-http-client
MINERU_PROVIDER=openai-compatible
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_MODEL=
MINERU_TIMEOUT=180
MINERU_MAX_CONCURRENCY=8

# off or vlm. Only visual-only pages are sent to this constrained classifier.
PAGE_ROLE_CLASSIFIER=vlm
PAGE_ROLE_BASE_URL=
PAGE_ROLE_API_KEY=
PAGE_ROLE_MODEL=
PAGE_ROLE_TIMEOUT=120
PAGE_RECOVERY_BASE_URL=
PAGE_RECOVERY_API_KEY=
PAGE_RECOVERY_MODEL=
PAGE_RECOVERY_TIMEOUT=180
PAGE_RECOVERY_MAX_TOKENS=4096

# local, minio, or s3writer
DATA_ASSET_MODE=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=okfolio-assets
S3_PREFIX=okfolio
S3_REGION=us-east-1
S3_VERIFY_TLS=false
S3_PUBLIC_BASE_URL=

MCP_ENABLE_WRITES=false
OKFOLIO_MCP_PORT=3099
